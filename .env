# Copy this file to .env and replace CHANGE_ME with your local password.
# Keep .env out of Git.

DATABASE_URL=mysql+pymysql://pipeline_user:pipeline@127.0.0.1:3306/reconciliation

# SQLite alternative. Comment out the MySQL line before enabling this.
# DATABASE_URL=sqlite:///warehouse/reconciliation.db

PARQUET_DIR=warehouse/parquet
ORDERS_FILE=orders.csv
LOG_LEVEL=INFO
SCHEDULE_TZ=Asia/Kolkata